{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "factory-v2/contracts/distribution-handoff.schema.json",
  "title": "Factory v2 distribution handoff",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_type",
    "contract_version",
    "handoff",
    "mission_id",
    "approved_rc",
    "deployment_artifact",
    "owner_approval",
    "release",
    "deployment",
    "rollback"
  ],
  "properties": {
    "contract_type": { "const": "factory.v2.distribution_handoff" },
    "contract_version": { "const": "1.0.0" },
    "handoff": {
      "type": "object",
      "additionalProperties": false,
      "required": ["handoff_id", "created_at"],
      "properties": {
        "handoff_id": { "$ref": "#/$defs/identifier" },
        "created_at": { "$ref": "#/$defs/timestamp" }
      }
    },
    "mission_id": { "$ref": "#/$defs/identifier" },
    "approved_rc": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rc_id", "candidate_id", "source_revision", "artifact_hash"],
      "properties": {
        "rc_id": { "$ref": "#/$defs/identifier" },
        "candidate_id": { "$ref": "#/$defs/identifier" },
        "source_revision": { "$ref": "#/$defs/revision" },
        "artifact_hash": { "$ref": "#/$defs/content_hash" }
      }
    },
    "deployment_artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_uri",
        "candidate_id",
        "source_revision",
        "artifact_hash",
        "immutable"
      ],
      "properties": {
        "artifact_uri": { "type": "string", "minLength": 1 },
        "candidate_id": { "$ref": "#/$defs/identifier" },
        "source_revision": { "$ref": "#/$defs/revision" },
        "artifact_hash": { "$ref": "#/$defs/content_hash" },
        "immutable": { "const": true }
      }
    },
    "owner_approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision", "rc_id", "candidate_id", "approved_at", "evidence"],
      "properties": {
        "decision": { "const": "APPROVE" },
        "rc_id": { "$ref": "#/$defs/identifier" },
        "candidate_id": { "$ref": "#/$defs/identifier" },
        "approved_at": { "$ref": "#/$defs/timestamp" },
        "evidence": { "$ref": "#/$defs/evidence_ref" }
      }
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": ["release_id", "version", "created_at"],
      "properties": {
        "release_id": { "$ref": "#/$defs/identifier" },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "created_at": { "$ref": "#/$defs/timestamp" }
      }
    },
    "deployment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["environment", "target", "parameters", "secret_values_present"],
      "properties": {
        "environment": { "type": "string", "minLength": 1 },
        "target": { "type": "string", "minLength": 1 },
        "parameters": { "type": "object" },
        "secret_values_present": { "const": false }
      }
    },
    "rollback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "recovery_identity", "evidence_refs"],
      "properties": {
        "required": { "const": true },
        "recovery_identity": {
          "type": "object",
          "additionalProperties": false,
          "required": ["rc_id", "artifact_hash"],
          "properties": {
            "rc_id": { "$ref": "#/$defs/identifier" },
            "artifact_hash": { "$ref": "#/$defs/content_hash" }
          }
        },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/evidence_ref" }
        }
      }
    }
  },
  "$defs": {
    "identifier": { "$ref": "common.schema.json#/$defs/identifier" },
    "revision": { "$ref": "common.schema.json#/$defs/revision" },
    "content_hash": { "$ref": "common.schema.json#/$defs/content_hash" },
    "timestamp": { "$ref": "common.schema.json#/$defs/timestamp" },
    "evidence_ref": { "$ref": "common.schema.json#/$defs/evidence_ref" }
  }
}
