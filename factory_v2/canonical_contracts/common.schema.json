{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "factory-v2/common.schema.json",
  "title": "Factory v2 shared contract definitions",
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "revision": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "content_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "evidence_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "uri", "revision", "content_hash", "immutable"],
      "properties": {
        "kind": { "$ref": "#/$defs/identifier" },
        "uri": { "type": "string", "minLength": 1 },
        "revision": { "$ref": "#/$defs/revision" },
        "content_hash": { "$ref": "#/$defs/content_hash" },
        "immutable": { "const": true }
      }
    },
    "criterion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "statement", "verification"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "statement": { "type": "string", "minLength": 1 },
        "verification": { "type": "string", "minLength": 1 }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate_id", "source_revision", "artifact_hash", "artifact_uri"],
      "properties": {
        "candidate_id": { "$ref": "#/$defs/identifier" },
        "source_revision": { "$ref": "#/$defs/revision" },
        "artifact_hash": { "$ref": "#/$defs/content_hash" },
        "artifact_uri": { "type": "string", "minLength": 1 }
      }
    },
    "defect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "severity", "statement", "evidence"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "severity": { "enum": ["BLOCKING", "MAJOR", "MINOR"] },
        "statement": { "type": "string", "minLength": 1 },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/evidence_ref" }
        }
      }
    },
    "verifier": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identity", "runtime", "independence"],
      "properties": {
        "identity": { "type": "string", "minLength": 1 },
        "runtime": {
          "type": "object",
          "additionalProperties": false,
          "required": ["harness", "version", "provenance_ref"],
          "properties": {
            "harness": { "type": "string", "minLength": 1 },
            "version": { "type": "string", "minLength": 1 },
            "provenance_ref": { "$ref": "#/$defs/evidence_ref" }
          }
        },
        "independence": {
          "type": "object",
          "additionalProperties": false,
          "required": ["independent_from_producer", "independent_from_candidate_author"],
          "properties": {
            "independent_from_producer": { "const": true },
            "independent_from_candidate_author": { "const": true }
          }
        }
      }
    }
  }
}
